<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF2FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado con degradado y estética atractiva -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#6366F1"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡ AutoWhatsReply"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Asistente de respuestas automáticas inteligentes"
                    android:textColor="#E0E7FF"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tarjeta de Control Principal (Switch Independiente) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <Switch
                    android:id="@+id/switchAutoReply"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Servicio de Autorespuesta"
                    android:textColor="#1E1B4B"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estado: Desactivado"
                    android:textColor="#6B7280"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Configuración de Reglas -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎯 Reglas de Disparo"
                    android:textColor="#4338CA"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Frase o palabra clave esperada:"
                    android:textColor="#374151"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etTrigger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej: hola! estoy en el evento"
                    android:textSize="14sp"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:id="@+id/tvSimilarityLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Porcentaje de similitud: 70%"
                    android:textColor="#1F2937"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/sbSimilarity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="70"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mensaje con el que responderás:"
                    android:textColor="#374151"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etReply"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Escribe la respuesta aquí..."
                    android:textSize="14sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Opciones de Filtro -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🛡️ Filtros y Horarios"
                    android:textColor="#4338CA"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <Switch
                    android:id="@+id/switchIgnoreGroups"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ignorar grupos de WhatsApp"
                    android:textColor="#1F2937"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <Switch
                    android:id="@+id/switchSchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Activar franja horaria (24h)"
                    android:textColor="#1F2937"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <EditText
                        android:id="@+id/etStartHour"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Inicio (ej: 22)"
                        android:inputType="number"
                        android:textSize="13sp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/etEndHour"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Fin (ej: 08)"
                        android:inputType="number"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Botones de Acción -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#4338CA"
            android:text="Guardar Cambios"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnTestMatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Probar Coincidencia de Mensaje"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conceder Permisos de Notificación"
            style="?attr/materialButtonOutlinedStyle" />

    </LinearLayout>
</ScrollView>
